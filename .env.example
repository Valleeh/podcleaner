# Copy to .env and fill in. Everything not listed here has a default the server states in
# its own configuration table; see docs/contract.md.

# The address this server is reachable at, as a podcatcher will see it. It goes into every
# link written into a rewritten feed, so getting it wrong means episodes that stop playing
# the moment anything moves.
PODCLEANER_BASE_URL=https://podclean.example.org

# One OpenRouter token, used for both transcription and classification.
PODCLEANER_LLM_API_KEY=

# Which model or models decide what is advertising. `cascade:screen>verifier` runs a cheap
# model over the transcript and a better one over what it found; a bare model id runs one
# pass. Whether a model reasons is its provider's default -- see docs/contract.md.
#PODCLEANER_LLM_SPEC=cascade:qwen/qwen3.7-flash>deepseek/deepseek-v4-flash

# The port published on the host. The container always listens on 8080.
#PODCLEANER_PORT=8080
